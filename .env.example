# Empty for a domain root; /repository-name for a GitHub Pages project.
NEXT_PUBLIC_BASE_PATH=
# Absolute site root, including the repository path for GitHub Pages.
NEXT_PUBLIC_SITE_URL=
# Optional HTTPS JSON endpoint (see docs/FORM-INTEGRATION.md).
NEXT_PUBLIC_BOOKING_ENDPOINT=
# Enable only after completing the owner's checklist.
NEXT_PUBLIC_INDEXABLE=false
